# Copiar a .env.local (no versionado) y completar.

# Cadena del SESSION POOLER de Supabase, puerto 5432. La conexión directa es
# IPv6 y no resuelve desde una red IPv4 (ver PROYECTO-chat-with-data.md, 4.2).
DATABASE_URL="postgresql://postgres.XXXXXXXX:TU-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# API key de Google AI Studio (https://aistudio.google.com/apikey).
# El nombre de variable lo exige @ai-sdk/google.
GOOGLE_GENERATIVE_AI_API_KEY="tu-api-key-de-gemini"

# Opcional — default: gemini-2.5-flash
# GEMINI_MODEL="gemini-2.5-flash"
